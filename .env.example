# ============================================
# SLACK EMOJI REACTOR BOT — Configuration
# ============================================
# Copie ce fichier en .env et remplis les valeurs
#   cp .env.example .env
# ============================================

# Bot User OAuth Token (xoxb-...)
# Trouvable dans : api.slack.com/apps > OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing Secret
# Trouvable dans : api.slack.com/apps > Basic Information
SLACK_SIGNING_SECRET=your-signing-secret-here

# App-Level Token pour Socket Mode (xapp-...)
# Trouvable dans : api.slack.com/apps > Basic Information > App-Level Tokens
SLACK_APP_TOKEN=xapp-your-app-token-here

# Emoji cible (sans les ::) — ex: partyparrot, fire, tada
TARGET_EMOJI=partyparrot

# (Optionnel) IDs des utilisateurs cibles pour l'auto-react
# Le bot réagira automatiquement avec l'emoji sur TOUS leurs messages
# Séparer les IDs par des virgules, sans espaces
# Pour trouver un ID : clic sur le profil Slack > ⋮ > Copy member ID
TARGET_USER_IDS=

# (Optionnel) IDs des admins qui ont accès à /jeanpip-attack sans condition
# Séparer les IDs par des virgules, sans espaces
JEANPIP_ADMINS=

# (Optionnel) Clé API Giphy pour médias dynamiques
# Laisser vide pour utiliser la banque locale media-bank.json
GIPHY_API_KEY=

# (Optionnel) Tag Giphy pour filtrer les GIFs
GIPHY_TAG=funny

# ============================================
# 🎬 Page d'ouverture de booster « à la FIFA »
# ============================================
# URL publique de la page (sans slash final), derrière le reverse proxy
# du dashboard. VIDE = page désactivée → ouverture dans Slack uniquement.
WEB_PUBLIC_URL=
# ex. WEB_PUBLIC_URL=https://dashboard-lorient.dimsi.cloud/jeanpip

# Port local du serveur web (écoute sur 127.0.0.1 uniquement)
WEB_PORT=3100

# (Optionnel) Secret de signature des liens. Vide = généré dans data/web-secret
WEB_SECRET=
